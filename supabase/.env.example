# URL base do Protheus acessível a partir de onde a Edge Function roda.
#
# Desenvolvimento local (supabase functions serve na sua máquina):
#   PROTHEUS_BASE_URL=http://192.168.200.2:9559
#
# Supabase Cloud (functions na nuvem): use URL pública com port forwarding,
# ex.: PROTHEUS_BASE_URL=http://seu-hostname.ddns.net:9559
# IPs 192.168.x.x NÃO funcionam na nuvem Supabase.
#
# Homologação (padrão / fallback de segurança): porta 9559
# Produção: porta 9505 — se PROTHEUS_BASE_URL_PROD não for definido, a porta
# de PROTHEUS_BASE_URL é trocada automaticamente para 9505.

PROTHEUS_BASE_URL=http://192.168.200.2:9559

# Opcional: URL explícita de produção (senão deriva de PROTHEUS_BASE_URL com :9505)
# PROTHEUS_BASE_URL_PROD=http://192.168.200.2:9505

# Caminho do endpoint de usuários do Protheus (placeholder)
PROTHEUS_USERS_PATH=/rest/users

# ID do usuário administrador padrão
ADMIN_USER_ID=000000-admin

# Logins Protheus considerados administrador (separados por vírgula)
ADMIN_USER_NAMES=admin,000000-admin
